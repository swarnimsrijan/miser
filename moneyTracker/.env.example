# Copy to .env (gitignored) and fill in. Read by docker-compose and by the app.
POSTGRES_PASSWORD=change-me
KEYCLOAK_ADMIN_PASSWORD=change-me
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me-at-least-16-chars

# App settings for local dev against the compose stack
STORAGE_TYPE=s3
S3_ENDPOINT=http://localhost:8333
S3_BUCKET=miser-statements
S3_CREATE_BUCKET=true
S3_SSE=false
OIDC_ISSUER_URI=http://localhost:8180/realms/miser
CORS_ALLOWED_ORIGINS=http://localhost:5000

# Optional: GitHub login (see infra/keycloak/enable-github-login.sh)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
