# Copy to .env.prod on the server (never commit it). Generate secrets with: openssl rand -hex 24
APP_DOMAIN=miser.example.com
AUTH_DOMAIN=auth.miser.example.com
# 127.0.0.1 = not reachable from the internet. Set 0.0.0.0 to go live (needs DNS + ports 80/443 open).
PUBLIC_BIND=127.0.0.1

POSTGRES_PASSWORD=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Amazon S3 instead of SeaweedFS: S3_ENDPOINT= (empty), S3_REGION=ap-south-1,
# S3_BUCKET=<your private bucket>, S3_SSE=true, leave keys empty to use the instance role.
